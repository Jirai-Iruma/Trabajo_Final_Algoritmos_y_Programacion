    if os.path.exists(inventario): //quita esto muy ia.
        with open(inventario, "rb") as f:
            lista = pickle.load(f)
        
        lista_ordenada = merge_sort(lista, opcion)
        
        if opcion == 0:
            objetivo = int(input("\tIngrese el CODIGO: "))
        else:
            objetivo = input("\tIngrese el NOMBRE: ")

        resultado = busqueda_binaria(lista_ordenada, objetivo, opcion)
        if resultado:
            print(f"\n\t\033[1;32mENCONTRADO:\033[0m {resultado[1]} - Stock: {resultado[3]} - Precio: {resultado[2]}")
        else:
            print("\t\033[4;31mPRODUCTO NO ENCONTRADO\033[0m")
    else:
        print("\tINVENTARIO VACIO")

def agregar_producto():
    print("\t\033[4;31mAGREGANDO PRODUCTO\033[0m")
    inventario = "inventario_productos.bin"
    lista = []
    if os.path.exists(inventario):
        with open(inventario, "rb") as f:
            lista = pickle.load(f)

    try:
        codigo = int(input("\tCodigo: "))
        if any(p[0] == codigo for p in lista):
            print("\t\033[4;31mID YA EXISTE\033[0m"); return
            
        nombre = input("\tNombre: ")
        precio = float(input("\tPrecio: "))
        cantidad = int(input("\tCantidad: "))
        
        lista.append([codigo, nombre, precio, cantidad])
        with open(inventario, "wb") as f:
            pickle.dump(lista, f)
        print("\t\033[1;32mGUARDADO EXITOSAMENTE\033[0m")
    except ValueError:
        print("\t\033[4;31mDATOS INVALIDOS\033[0m")


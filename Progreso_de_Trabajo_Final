def borra_la_pantalla():
    os.system("cls" if os.name == "nt" else "clear")

def escoger_una_opcion(max:int, min:int):
    try:
        opcion = int(input("\t"))
        if ((opcion < min) or (opcion > max)):
            print("\t\033[4;31mOPCION INVALIDA\033[0m")
            return escoger_una_opcion(max, min)
        return opcion
    except:
        print("\t\033[4;31mOPCION INVALIDA\033[0m")
        return escoger_una_opcion(max,min)

# --- ALGORITMOS (ORDENAMIENTO Y BÚSQUEDA) ---
def merge_sort(lista, opcion:int):
    if len(lista) <= 1:
        return lista
    mid = len(lista) // 2
    left_part = merge_sort(lista[:mid], opcion)
    right_part = merge_sort(lista[mid:], opcion)
    
    lista_final = []
    i = k = 0
    while i < len(left_part) and k < len(right_part):
        if left_part[i][opcion] <= right_part[k][opcion]:
            lista_final.append(left_part[i])
            i += 1
        else:
            lista_final.append(right_part[k])
            k += 1
    lista_final.extend(left_part[i:])
    lista_final.extend(right_part[k:])
    return lista_final

def busqueda_binaria(lista, objetivo, indice_columna):
    bajo = 0
    alto = len(lista) - 1
    while bajo <= alto:
        medio = (bajo + alto) // 2
        valor_actual = lista[medio][indice_columna]
        
        # Normalización para búsqueda por nombre (texto)
        if indice_columna == 1:
            valor_comparar = str(valor_actual).lower()
            objetivo_comparar = str(objetivo).lower()
        else:
            valor_comparar = valor_actual
            objetivo_comparar = objetivo

        if valor_comparar == objetivo_comparar:
            return lista[medio]
        elif valor_comparar < objetivo_comparar:
            bajo = medio + 1
        else:
            alto = medio - 1
    return None


